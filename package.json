{
  "name": "enterprise-saas-starter",
  "version": "1.0.0",
  "private": false,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "pnpm -r build",
    "dev": "pnpm --filter web dev",
    "deploy": "pnpm run build && pnpm --filter @saas-starter/infra run deploy && node scripts/sync-env.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@smithy/types": "4.14.1",
      "@aws-sdk/types": "3.973.8"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
